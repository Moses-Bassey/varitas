# Copy to .env and fill in. Never commit .env. Leave a value empty to disable that integration.

# --- Core ---------------------------------------------------------------
PORT=8000
# true = offline demonstration on bundled fictional data; no sponsor calls, no network.
SAMPLE_MODE=false
LOG_DIR=./logs
INVESTIGATION_BUDGET_SECONDS=420
MAX_REASONING_ITERATIONS=3
PROVIDER_RETRY_ATTEMPTS=2
URL_FETCH_ENABLED=true
MAX_CONTENT_CHARS=50000
MAX_FETCH_BYTES=2097152

# --- Meterless Nightshift (primary reasoning model) ---------------------
# Local runtime. From inside Docker use http://host.docker.internal:8088/v1
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# Runtime token from <stateDir>/proxy-token (the rt-local placeholder is rejected).
METERLESS_RUNTIME_TOKEN=
# Routing mode: meterless/auto | fast | deep | cheap | local | fusion
METERLESS_MODEL=meterless/auto
METERLESS_APP_ID=veritas
METERLESS_TIMEOUT_SECONDS=60

# --- Zetaris (primary evidence data layer, direct REST) -----------------
# From inside Docker use http://host.docker.internal:8888/api/v1.0 for a local Zetaris.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_API_KEY=
ZETARIS_ORG_ID=
# Table registered in Zetaris with the schema in docs/zetaris_setup.md, e.g. veritas.evidence_sources
ZETARIS_EVIDENCE_TABLE=
ZETARIS_QUERY_LIMIT=50
ZETARIS_TIMEOUT_SECONDS=45

# --- Meterless H-MEM engine (investigative memory) ----------------------
# H-MEM sidecar (engines/hmem-sidecar). With docker compose: http://hmem:8787
HMEM_URL=
HMEM_SIDECAR_TOKEN=
HMEM_TIMEOUT_SECONDS=45
# Minimum relevance passed to the engine's query(). The reference engine's mock embedder scores lower than its 0.35 default.
HMEM_RECALL_THRESHOLD=0.2

# --- NVIDIA (independent second-pass review) ----------------------------
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
NVIDIA_TIMEOUT_SECONDS=45

# --- Dashboard ----------------------------------------------------------
VERITAS_API_URL=http://localhost:8000
